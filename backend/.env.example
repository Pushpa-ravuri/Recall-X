# Hindsight Experience Memory
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recall-x
# Optional persistent local history and analytics cache path.
# Defaults to ../data/incidents.json relative to this backend package.
# RECALL_X_DATA_FILE=/var/lib/recall-x/incidents.json
# Groq LLM Reasoning
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Operational Mode
# When DEMO_MODE=true, if Hindsight or Groq is unreachable, fallback to high-fidelity seed experience data
# with explicit UI labeling: "[DEMO DATA — Hindsight unavailable]"
DEMO_MODE=true
# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:3000
